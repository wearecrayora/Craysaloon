<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Android 13 (API 33) made notifications a RUNTIME permission. Without
         this, and without asking for it, a push is delivered to the device and
         silently dropped instead of being shown - the token works, the ack
         never fires, and every message escalates to a channel the salon pays
         for. The failure is invisible: nothing errors. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application
        android:label="craysalon"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- The printed QR (ARCHITECTURE 5.6). autoVerify makes this an
                 Android App Link: the phone checks
                 https://join.craysalon.in/.well-known/assetlinks.json for this
                 app's signing fingerprint and, when it matches, opens the app
                 with no chooser. Until that file is published WITH THE RELEASE
                 FINGERPRINT (M13 owns release signing), verification fails and
                 the link opens the site instead - which is why join/ serves a
                 page that shows the code and links to Play rather than a blank
                 redirect. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="join.craysalon.in" android:pathPrefix="/s"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>

        <!-- Android 11 package visibility. Without these the app cannot SEE a
             browser, a mail app or a dialler, and every link in the privacy
             notice fails silently - the privacy policy, and the salon's own
             contact for a complaint. The notice is required to be reachable
             (DPDP ss.5, 13), so this is not optional polish. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="mailto"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
    </queries>
</manifest>
