# Dart / Flutter
.dart_tool/
.packages
build/
*.iml
.flutter-plugins
.flutter-plugins-dependencies
app/android/key.properties
app/**/GoogleService-Info.plist

# Firebase/Google service-account keys. These are RSA PRIVATE KEYS - the server
# credential that can send push as this project - and they download with a
# generated name nobody would think to list. Pattern, not filename.
*-firebase-adminsdk-*.json
**/*service-account*.json
**/*serviceaccount*.json
app/android/app/google-services.json
# ...and anywhere else they land. These arrive as downloads and get dropped at
# the repo root on the way to app/; google-services.json carries an AIza key and
# this repo is public, so the pattern is unanchored on purpose - a path-scoped
# rule protects the copy you remembered to put in the right place.
google-services.json
GoogleService-Info.plist
**/google-services.json
**/GoogleService-Info.plist

# Node
node_modules/
.next/
dist/
*.tsbuildinfo

# Supabase
supabase/.branches/
supabase/.temp/

# Env and secrets - NEVER commit
.env
.env.*
# Shape documentation, never values. These are committed on purpose so a new
# environment can be set up without guessing which variables exist.
!.env.example
!*.env.example
!console/.env.local.example
*.pem
*.p8
*.jks
*.keystore

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json

# Vendored agent skills - reinstall with the command in CLAUDE.md
.agents/
.claude/skills/

scripts/db/node_modules/

# Generated at deploy time from the real signing certificate, never committed:
# a placeholder fingerprint fails Android App Link verification silently
# (join/README.md, GATE-8).
join/public/.well-known/assetlinks.json
