# Client-safe (ships in the APK / browser bundle by design)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# SERVER ONLY - never in the APK, never in the Vercel client bundle (RULES.md 11.1)
SUPABASE_SERVICE_ROLE_KEY=
MESSAGE_CENTRAL_AUTH_KEY=
MESSAGE_CENTRAL_CUSTOMER_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_PROJECT_ID=
# Public value - ships in the client. Supplied at build time via
#   flutter build apk --dart-define=SENTRY_DSN=$SENTRY_DSN
SENTRY_DSN=
# PHONE_HASH_PEPPER is deliberately NOT here. The pepper for app.phone_hash
# lives only in Supabase Vault, created in-database by migration 0023 and never
# exported - nothing outside Postgres ever needs it, and a second copy in a
# .env file is a second place it can leak from. Rotating it invalidates every
# customer_identities row and needs a planned re-hash migration.
