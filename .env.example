# Client-safe (ships in the APK / browser bundle by design)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# SERVER ONLY - never in the APK, never in the Vercel client bundle (RULES.md 11.1)
#
# SUPABASE_SERVICE_ROLE_KEY was the old name and the old key format. Supabase's
# current format is sb_secret_..., held in SUPABASE_SECRET_KEY above.

# --- Cloudflare R2 --------------------------------------------------------
# Blocks: the printable QR pack (counter card, mirror sticker, poster) that
# provisioning is supposed to produce, and later logos, photos and invoices.
# Private objects are served through signed URLs, never a public bucket.
#
# Cloudflare dashboard -> R2 -> Manage API tokens -> Create API token,
# permission "Object Read & Write", scoped to the one bucket.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Derived, but kept explicit so a different endpoint can be used without code
# changes: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# --- Message Central: CRAYORA's own platform account ----------------------
# Blocks: the sms-hook Edge Function and the whole of M3. PHASES M3 says this
# account must exist before that milestone starts.
#
# This is NOT the account that sends a salon's OTPs - each salon's own
# credentials are entered per salon in the console and stored in Vault. This
# one is the logged, alerted fallback for when a salon's account fails, and
# what the hook authenticates against while being built.
#
# No DLT registration anywhere: Message Central is top-up-and-send.
MESSAGE_CENTRAL_AUTH_KEY=
MESSAGE_CENTRAL_CUSTOMER_ID=

# --- Razorpay: TEST keys, for building against the sandbox ----------------
# Not blocking anything yet. Needed when wallet top-ups get built, and useful
# earlier as a realistic value for the console's credentials screen.
#
# Live per-salon keys never appear here - customer money settles into the
# salon's own account, and Crayora holds no float (RULES 8).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_PROJECT_ID=
# Public value - ships in the client. Supplied at build time via
#   flutter build apk --dart-define=SENTRY_DSN=$SENTRY_DSN
SENTRY_DSN=
# PHONE_HASH_PEPPER is deliberately NOT here. The pepper for app.phone_hash
# lives only in Supabase Vault, created in-database by migration 0023 and never
# exported - nothing outside Postgres ever needs it, and a second copy in a
# .env file is a second place it can leak from. Rotating it invalidates every
# customer_identities row and needs a planned re-hash migration.
