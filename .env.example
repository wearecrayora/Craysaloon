# Shape only. Never a real value - this file is COMMITTED.
#
# Copy to .env (gitignored) and fill in. `scripts/secret-scan.sh` reads the real
# .env and greps build outputs for the literal values below, which is how a
# pepper or a database password - neither of which has a recognisable shape -
# gets caught before it ships.

# --- Supabase -------------------------------------------------------------
# The project the whole of development runs against. There is no local stack
# (CLAUDE.md, PHASES option A): migrations go to the hosted project with
# scripts/db-push.sh, and `db reset` would wipe shared data.
SUPABASE_PROJECT_REF=
SUPABASE_URL=

# Client-safe by design - ships in the APK and the browser bundle.
# Current key format: sb_publishable_...
SUPABASE_PUBLISHABLE_KEY=

# SERVER ONLY. Current format: sb_secret_... (the old name and format,
# SUPABASE_SERVICE_ROLE_KEY, is gone). Never in the APK, never in the Vercel
# client bundle (RULES.md 11.1).
SUPABASE_SECRET_KEY=

# Direct Postgres, for migrations and the pgTAP gates (scripts/db/run.mjs).
# postgresql://postgres.<ref>:<password>@<pooler-host>:5432/postgres
DATABASE_URL=

# JWTs are ES256 verified via JWKS - there is no shared symmetric secret.
SUPABASE_JWKS_URL=
SUPABASE_JWT_KEY_ID=

# Personal access token (sbp_...) for the Management API: Edge Function
# secrets, auth settings, the claims hook. The most powerful value in this
# file - it can administer the whole project.
SUPABASE_ACCESS_TOKEN=

# --- Cloudflare R2 --------------------------------------------------------
# The printable QR pack (counter card, mirror sticker, poster), and later
# logos, photos and invoices. Private objects are served through signed URLs,
# never a public bucket.
#
# Cloudflare dashboard -> R2 -> Manage API tokens -> Create API token,
# permission "Object Read & Write", scoped to the one bucket.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Derived, but kept explicit so a different endpoint can be used without code
# changes: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# Account-wide Cloudflare token. The single most damaging value here: it can
# create and delete every bucket. Replace with a scoped one at launch.
CLOUDFLARE_API_TOKEN=

# --- Message Central: CRAYORA's own platform account ----------------------
# This is NOT the account that sends a salon's OTPs - each salon's own
# credentials are entered per salon in the console and stored in Vault
# (RULES.md 8.12). This one is the fallback that is logged and alerted, and
# what covers a salon during a messaging trial (ADR-37).
#
# No DLT registration anywhere: OTPs go out under Message Central's own
# DLT-registered name (ADR-36).
MESSAGE_CENTRAL_AUTH_KEY=
MESSAGE_CENTRAL_CUSTOMER_ID=
MESSAGE_CENTRAL_BASE_URL=

# --- Razorpay: TEST keys, for building against the sandbox ----------------
# Live per-salon keys never appear here - customer money settles into the
# salon's own account, and Crayora holds no float (RULES.md 8).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Sentry ---------------------------------------------------------------
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_PROJECT_ID=
# Public value - ships in the client. Supplied at build time via
#   flutter build apk --dart-define=SENTRY_DSN=$SENTRY_DSN
SENTRY_DSN=

# --- The phone-number pepper ----------------------------------------------
# The AUTHORITATIVE copy lives only in Supabase Vault, created in-database by
# migration 0023. Nothing in this repo reads this value to compute a hash -
# app.phone_hash reads Vault, and the pepper test proves it works with no
# session GUC set at all.
#
# It is listed here for ONE reason: secret-scan.sh greps build outputs for its
# literal value, and a pepper has no recognisable shape to pattern-match. If
# this is blank, that check silently passes without checking anything.
#
# Rotating it invalidates every customer_identities row and needs a planned
# re-hash migration (see the rotation note in memory).
PHONE_HASH_PEPPER=
