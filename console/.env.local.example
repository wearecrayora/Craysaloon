# Console environment. Copy to .env.local for local development; in production
# these are Vercel environment variables.
#
# NOTHING with a real value belongs in this file - it is committed.

# --- Public: ships in the browser bundle -----------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# The PUBLISHABLE key only. Never the secret key (RULES 6.6, 8.1).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# --- Server only: never exposed to the browser ------------------------------
# The admin plane is NOT exposed through PostgREST (ADR-35), so the console
# reaches app_admin.* over a direct Postgres connection rather than via RPC.
# On Vercel use the TRANSACTION POOLER url (port 6543) - serverless functions
# open and close connections constantly and would exhaust direct slots.
ADMIN_DATABASE_URL=postgresql://user:password@host:6543/postgres
