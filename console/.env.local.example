# Console environment. Copy to .env.local (the Next.js dev server reads it) AND
# to .dev.vars (the Cloudflare Worker reads it: `npm run dev`, `npm start`).
# Both are gitignored. In production every one of these is a Worker secret:
#   npx wrangler secret put ADMIN_DATABASE_URL        (and so on, from console/)
# They are declared in cloudflare.config.ts, so a missing one is reported.
# The two NEXT_PUBLIC_ values are ALSO baked into the browser bundle at build
# time, so they must be present wherever `npm run build` / `npm run deploy` runs.
#
# NOTHING with a real value belongs in this file - it is committed.

# --- Public: ships in the browser bundle -----------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# The PUBLISHABLE key only. Never the secret key (RULES 6.6, 8.1).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# --- Server only: never exposed to the browser ------------------------------
# The admin plane is NOT exposed through PostgREST (ADR-35), so the console
# reaches app_admin.* over a direct Postgres connection rather than via RPC.
# Use the TRANSACTION POOLER url (port 6543) - Workers open and close
# connections constantly and would exhaust the direct connection slots.
ADMIN_DATABASE_URL=postgresql://user:password@host:6543/postgres

# --- Cloudflare R2: SERVER ONLY -------------------------------------------
# The QR pack is written here and handed out through short-lived signed URLs;
# the bucket is private. Never prefix these with NEXT_PUBLIC_ - that inlines
# them into the browser bundle, and these keys can write to every bucket on
# the account. The secret scan checks the built bundle for their values.
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=craysalon-assets
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Server errors to Sentry (ARCHITECTURE 16). Optional: without it nothing is sent.
# Use a DSN for a "console" project, not the app's.
SENTRY_DSN=
